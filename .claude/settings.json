            "timeout_ms": 5000,
            "_hook_name": "simplify-ignore"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/anatomy-index/handler.sh",
            "timeout_ms": 10000,
