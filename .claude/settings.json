{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/anatomy-index/handler.sh",
            "timeout_ms": 10000,
            "_hook_name": "anatomy-index"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-protection/handler.sh",
            "timeout_ms": 5000,
            "_hook_name": "git-protection"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stack-guard/handler.sh",
            "timeout_ms": 5000,
            "_hook_name": "stack-guard"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-edit-backup/handler.sh",
            "timeout_ms": 5000,
            "_hook_name": "pre-edit-backup"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
